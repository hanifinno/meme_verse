rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Memes Collection
    match /memes/{memeId} {
      // Anyone can read memes.
      allow read: if true;

      // Anyone can create (upload) a meme.
      // This fulfills your requirement for unauthenticated uploads.
      allow create: if true;

      // IMPORTANT: This prevents anyone from updating or deleting memes,
      // protecting your data. You can make this more specific later if needed.
      allow update, delete: if false;

      // Comments Subcollection
      match /comments/{commentId} {
        // Anyone can read comments.
        allow read: if true;

        // Only authenticated users can create comments.
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

        // Only the user who wrote the comment can update or delete it.
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }

    // Users Collection
    match /users/{userId} {
      // A user can only read, create, or update their own document.
      // This is useful for managing things like a list of saved memes.
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
    }
  }
}
